# Always-on HTTP deployment template. Copy to .env and fill in secrets.
# .env is gitignored; do not commit real credentials.

FUB_API_KEY=your_api_key_here

# Full access: enables delete tools. Change to true to disable delete tools.
FUB_SAFE_MODE=false

# HTTP transport for desktop/mobile/Codex-compatible remote MCP clients.
MCP_TRANSPORT=http
PORT=3000

# Pick exactly one auth mode for non-local use.
# Static bearer token: generate with `openssl rand -hex 32`.
MCP_BEARER_TOKEN=replace_with_random_token

# OAuth password-gated flow for clients that support MCP custom connectors.
# MCP_AUTH_PASSWORD=replace_with_strong_password

# Never expose this server publicly with auth disabled.
MCP_AUTH_DISABLED=false
